{
  "version": 2,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*": {
      "includeFiles": "node_modules/{pdfjs-dist,unpdf,pdf-parse}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}

